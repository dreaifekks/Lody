diff --git a/src/voice.ts b/src/voice.ts
new file mode 100644
index 0000000..7db0530
--- /dev/null
+++ b/src/voice.ts
@@ -0,0 +1,58 @@
+/**
+ * Experimental realtime voice, hosted by an agent process without an ACP
+ * session. The client owns the microphone and the WebRTC peer; the agent only
+ * negotiates the call and reports what was heard. A spoken request never
+ * starts work inside the agent: it comes back as a `request` event, the client
+ * sends it through its own prompt path, and returns the result with
+ * `_lody/voice/append` so the voice can speak it.
+ */
+export type LodyVoiceMode = 'conversation' | 'dictation';
+
+export type LodyVoiceStartRequest = {
+  mode: LodyVoiceMode;
+  /** SDP offer of a peer with one audio track and an `oai-events` data channel. */
+  sdp: string;
+  /** Extra instructions for the voice, e.g. the language to answer in. */
+  instructions?: string | undefined;
+  /** Background the voice starts from, e.g. the conversation so far (conversation only). */
+  context?: string | undefined;
+  /**
+   * A name from `_lody/voice/voices`. One the agent does not offer falls back
+   * to its default voice instead of failing the call.
+   */
+  voice?: string | undefined;
+};
+
+export type LodyVoiceStartResponse = {
+  voiceSessionId: string;
+  /** SDP answer for the client's peer. */
+  sdp: string;
+};
+
+export type LodyVoiceAppendRequest = {
+  voiceSessionId: string;
+  /** Context the voice should relay, typically the result of a request. */
+  text: string;
+};
+
+/** The voices a call can use; requires `voice.voices` in the capability. */
+export type LodyVoiceVoicesResponse = {
+  voices: string[];
+  /** The voice a call without `voice` uses. */
+  defaultVoice: string;
+};
+
+export type LodyVoiceStopRequest = {
+  voiceSessionId: string;
+};
+
+export type LodyVoiceEvent =
+  | { type: 'transcript'; role: 'user' | 'assistant'; text: string }
+  | { type: 'request'; requestId: string; text: string }
+  | { type: 'closed'; reason: string | null }
+  | { type: 'error'; message: string };
+
+export type LodyVoiceEventNotification = {
+  voiceSessionId: string;
+  event: LodyVoiceEvent;
+};

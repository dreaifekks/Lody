diff --git a/src/__tests__/VoiceExtension.test.ts b/src/__tests__/VoiceExtension.test.ts
new file mode 100644
index 0000000..9045a37
--- /dev/null
+++ b/src/__tests__/VoiceExtension.test.ts
@@ -0,0 +1,157 @@
+import {existsSync} from "node:fs";
+import {describe, expect, it} from "vitest";
+import type {LodyVoiceEventNotification} from "acp-extension-core";
+import type {ServerNotification} from "../app-server";
+import {CodexVoiceSessions, type VoiceAppServer} from "../VoiceExtension";
+
+/** An app-server that answers a call with `sdp` and records what it was asked. */
+class FakeAppServer implements VoiceAppServer {
+    readonly requests: {method: string, params: Record<string, unknown>}[] = [];
+    readonly interrupts: {threadId: string, turnId: string}[] = [];
+    readonly threadDirectories: string[] = [];
+    private readonly handlers = new Map<string, (event: ServerNotification) => void>();
+
+    constructor(private readonly answer: (threadId: string) => ServerNotification) {}
+
+    async threadStart(params: {cwd?: string | null}) {
+        this.threadDirectories.push(params.cwd ?? "");
+        return {thread: {id: `thread-${this.threadDirectories.length}`}} as never;
+    }
+
+    onServerNotification(threadId: string, callback: (event: ServerNotification) => void) {
+        this.handlers.set(threadId, callback);
+    }
+
+    offServerNotification(threadId: string) {
+        this.handlers.delete(threadId);
+    }
+
+    async experimentalRequest(method: string, params: Record<string, unknown>) {
+        this.requests.push({method, params});
+        if (method === "thread/realtime/start") {
+            const threadId = params["threadId"] as string;
+            queueMicrotask(() => this.emit(this.answer(threadId)));
+        }
+        return {};
+    }
+
+    async turnInterrupt(params: {threadId: string, turnId: string}) {
+        this.interrupts.push(params);
+        return {};
+    }
+
+    emit(event: ServerNotification) {
+        const threadId = (event.params as {threadId: string}).threadId;
+        this.handlers.get(threadId)?.(event);
+    }
+
+    isSubscribed(threadId: string) {
+        return this.handlers.has(threadId);
+    }
+}
+
+const sdpAnswer = (threadId: string) =>
+    ({method: "thread/realtime/sdp", params: {threadId, sdp: "answer-sdp"}}) as ServerNotification;
+
+const flush = () => new Promise((resolve) => setTimeout(resolve, 0));
+
+function createSessions(appServer: FakeAppServer) {
+    const events: LodyVoiceEventNotification[] = [];
+    const sessions = new CodexVoiceSessions(() => appServer, async (params) => {
+        events.push(params);
+    });
+    return {sessions, events};
+}
+
+describe("CodexVoiceSessions", () => {
+    it("answers the call and reports a spoken request instead of running it", async () => {
+        const appServer = new FakeAppServer(sdpAnswer);
+        const {sessions, events} = createSessions(appServer);
+
+        const started = await sessions.start({mode: "conversation", sdp: "offer-sdp", instructions: "Answer in Japanese."});
+        expect(started.sdp).toBe("answer-sdp");
+        const start = appServer.requests.find((request) => request.method === "thread/realtime/start");
+        expect(start?.params).toMatchObject({
+            threadId: "thread-1",
+            version: "v3",
+            outputModality: "audio",
+            transport: {type: "webrtc", sdp: "offer-sdp"},
+            initialItems: [{role: "developer", text: "Answer in Japanese."}],
+        });
+
+        appServer.emit({
+            method: "thread/realtime/itemAdded",
+            params: {threadId: "thread-1", item: {type: "handoff_request", handoff_id: "h1", input_transcript: " list the files "}},
+        } as ServerNotification);
+        appServer.emit({
+            method: "turn/started",
+            params: {threadId: "thread-1", turn: {id: "turn-1"}},
+        } as ServerNotification);
+        await flush();
+
+        expect(events).toContainEqual({
+            voiceSessionId: started.voiceSessionId,
+            event: {type: "request", requestId: "h1", text: "list the files"},
+        });
+        expect(appServer.interrupts).toEqual([{threadId: "thread-1", turnId: "turn-1"}]);
+    });
+
+    it("relays a result to the voice as developer context", async () => {
+        const appServer = new FakeAppServer(sdpAnswer);
+        const {sessions} = createSessions(appServer);
+        const started = await sessions.start({mode: "conversation", sdp: "offer-sdp"});
+
+        await sessions.append({voiceSessionId: started.voiceSessionId, text: "Three files."});
+
+        expect(appServer.requests.at(-1)).toEqual({
+            method: "thread/realtime/appendText",
+            params: {threadId: "thread-1", role: "developer", text: "Three files."},
+        });
+    });
+
+    it("keeps dictation silent and never turns speech into a request", async () => {
+        const appServer = new FakeAppServer(sdpAnswer);
+        const {sessions, events} = createSessions(appServer);
+        await sessions.start({mode: "dictation", sdp: "offer-sdp"});
+
+        const start = appServer.requests.find((request) => request.method === "thread/realtime/start");
+        expect(start?.params["prompt"]).toEqual(expect.stringContaining("silent"));
+        appServer.emit({
+            method: "thread/realtime/itemAdded",
+            params: {threadId: "thread-1", item: {type: "handoff_request", handoff_id: "h1", input_transcript: "delete it"}},
+        } as ServerNotification);
+        appServer.emit({
+            method: "turn/started",
+            params: {threadId: "thread-1", turn: {id: "turn-1"}},
+        } as ServerNotification);
+        await flush();
+
+        expect(events.filter((event) => event.event.type === "request")).toEqual([]);
+        expect(appServer.interrupts).toEqual([{threadId: "thread-1", turnId: "turn-1"}]);
+    });
+
+    it("stops the call, drops its thread and removes its directory", async () => {
+        const appServer = new FakeAppServer(sdpAnswer);
+        const {sessions, events} = createSessions(appServer);
+        const started = await sessions.start({mode: "conversation", sdp: "offer-sdp"});
+
+        await sessions.stop({voiceSessionId: started.voiceSessionId});
+
+        expect(appServer.requests.at(-1)).toEqual({method: "thread/realtime/stop", params: {threadId: "thread-1"}});
+        expect(appServer.isSubscribed("thread-1")).toBe(false);
+        expect(existsSync(appServer.threadDirectories[0]!)).toBe(false);
+        expect(events.at(-1)).toEqual({voiceSessionId: started.voiceSessionId, event: {type: "closed", reason: "requested"}});
+        await expect(sessions.append({voiceSessionId: started.voiceSessionId, text: "late"})).rejects.toThrow(/Unknown voice session/);
+    });
+
+    it("fails the start when Codex rejects the call and cleans up", async () => {
+        const appServer = new FakeAppServer((threadId) =>
+            ({method: "thread/realtime/error", params: {threadId, message: "not entitled"}}) as ServerNotification);
+        const {sessions} = createSessions(appServer);
+
+        await expect(sessions.start({mode: "conversation", sdp: "offer-sdp"})).rejects.toThrow("not entitled");
+
+        expect(appServer.isSubscribed("thread-1")).toBe(false);
+        expect(existsSync(appServer.threadDirectories[0]!)).toBe(false);
+    });
+});

diff --git a/src/VoiceExtension.ts b/src/VoiceExtension.ts
new file mode 100644
index 0000000..2594427
--- /dev/null
+++ b/src/VoiceExtension.ts
@@ -0,0 +1,424 @@
+import {mkdtempSync, rmSync} from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import {randomUUID} from "node:crypto";
+import {z} from "zod";
+import type {
+    LodyVoiceAppendRequest,
+    LodyVoiceEvent,
+    LodyVoiceEventNotification,
+    LodyVoiceStartRequest,
+    LodyVoiceStartResponse,
+    LodyVoiceStopRequest,
+    LodyVoiceVoicesResponse,
+} from "acp-extension-core";
+import {LODY_EXTENSION_METHODS} from "acp-extension-core";
+import type {RealtimeVoicesList, ServerNotification} from "./app-server";
+import type {ThreadStartParams} from "./app-server/v2/ThreadStartParams";
+import type {ThreadStartResponse} from "./app-server/v2/ThreadStartResponse";
+import {logger} from "./Logger";
+import type {CodexAcpServer} from "./CodexAcpServer";
+
+export const VOICE_START_METHOD = LODY_EXTENSION_METHODS.voiceStart;
+export const VOICE_APPEND_METHOD = LODY_EXTENSION_METHODS.voiceAppend;
+export const VOICE_STOP_METHOD = LODY_EXTENSION_METHODS.voiceStop;
+export const VOICE_EVENT_METHOD = LODY_EXTENSION_METHODS.voiceEvent;
+export const VOICE_VOICES_METHOD = LODY_EXTENSION_METHODS.voiceVoices;
+
+const SDP_ANSWER_TIMEOUT_MS = 30_000;
+
+const voiceStartParamsParser = z
+    .object({
+        mode: z.enum(["conversation", "dictation"]),
+        sdp: z.string().min(1),
+        instructions: z.string().optional(),
+        context: z.string().optional(),
+        voice: z.string().optional(),
+    })
+    .passthrough();
+
+const voiceVoicesParamsParser = z.preprocess(
+    (params) => params ?? {},
+    z.object({}).passthrough(),
+);
+
+const voiceAppendParamsParser = z
+    .object({
+        voiceSessionId: z.string().min(1),
+        text: z.string().min(1),
+    })
+    .passthrough();
+
+const voiceStopParamsParser = z
+    .object({
+        voiceSessionId: z.string().min(1),
+    })
+    .passthrough();
+
+type VoiceRequestRouter<T> = {
+    onRequest(
+        method: string,
+        parser: z.ZodTypeAny,
+        handler: (ctx: {params: any}) => Promise<unknown>,
+    ): T;
+};
+
+/** Registers the voice requests on a v1 or v2 agent router. */
+export function registerVoiceRequests<T extends VoiceRequestRouter<T>>(
+    router: T,
+    getAgent: () => CodexAcpServer,
+): T {
+    return router
+        .onRequest(VOICE_START_METHOD, voiceStartParamsParser, (ctx) =>
+            getAgent().voice.start(ctx.params),
+        )
+        .onRequest(VOICE_APPEND_METHOD, voiceAppendParamsParser, (ctx) =>
+            getAgent().voice.append(ctx.params),
+        )
+        .onRequest(VOICE_STOP_METHOD, voiceStopParamsParser, (ctx) =>
+            getAgent().voice.stop(ctx.params),
+        )
+        .onRequest(VOICE_VOICES_METHOD, voiceVoicesParamsParser, () =>
+            getAgent().voice.voices(),
+        );
+}
+
+const DICTATION_PROMPT = [
+    "You are a silent dictation service.",
+    "Never answer, comment, ask questions or delegate work.",
+    "Whatever the user says, stay silent.",
+].join(" ");
+
+/**
+ * Calls run on realtime v3, which takes its voices from the list Codex calls
+ * `v1` (`RealtimeVoicesList::builtin()`, `validate_realtime_voice` in
+ * codex-rs/core/src/realtime_conversation.rs, Codex 0.159).
+ */
+function voicesForCalls(list: RealtimeVoicesList): LodyVoiceVoicesResponse {
+    return {voices: [...list.v1], defaultVoice: list.defaultV1};
+}
+
+/** The app-server surface a voice session needs; `CodexAppServerClient` provides it. */
+export interface VoiceAppServer {
+    threadStart(params: ThreadStartParams): Promise<ThreadStartResponse>;
+    onServerNotification(
+        threadId: string,
+        callback: (event: ServerNotification) => void,
+    ): void;
+    offServerNotification(threadId: string): void;
+    experimentalRequest(
+        method: string,
+        params: Record<string, unknown>,
+    ): Promise<unknown>;
+    turnInterrupt(params: {threadId: string; turnId: string}): Promise<unknown>;
+}
+
+type VoiceSession = {
+    id: string;
+    mode: LodyVoiceStartRequest["mode"];
+    threadId: string;
+    appServer: VoiceAppServer;
+    directory: string;
+    closed: boolean;
+};
+
+/**
+ * Realtime voice sessions hosted on throwaway Codex threads. The voice model's
+ * delegation tool would start a Codex turn on its own thread; instead the
+ * request is reported to the client and the turn is interrupted at once, so
+ * every piece of work runs through the client's normal prompt path.
+ */
+export class CodexVoiceSessions {
+    private readonly sessions = new Map<string, VoiceSession>();
+    /** The list is built into the Codex binary, so one answer holds for the process. */
+    private voiceList: Promise<LodyVoiceVoicesResponse> | null = null;
+
+    constructor(
+        private readonly appServer: () => VoiceAppServer,
+        private readonly notify: (
+            params: LodyVoiceEventNotification,
+        ) => Promise<void>,
+    ) {}
+
+    /** The voices a call can use, from `thread/realtime/listVoices`. */
+    voices(): Promise<LodyVoiceVoicesResponse> {
+        if (!this.voiceList) {
+            const appServer = this.appServer();
+            this.voiceList = appServer
+                .experimentalRequest("thread/realtime/listVoices", {})
+                .then((response) =>
+                    voicesForCalls(
+                        (response as {voices: RealtimeVoicesList}).voices,
+                    ),
+                );
+            this.voiceList.catch(() => {
+                this.voiceList = null;
+            });
+        }
+        return this.voiceList;
+    }
+
+    /**
+     * The requested voice when Codex offers it for calls, else none, so Codex
+     * uses its default: Codex rejects a call whose voice it does not know.
+     */
+    private async resolveVoice(
+        voice: string | undefined,
+    ): Promise<string | undefined> {
+        if (!voice) {
+            return undefined;
+        }
+        try {
+            const {voices} = await this.voices();
+            if (voices.includes(voice)) {
+                return voice;
+            }
+            logger.log(
+                `Voice "${voice}" is not offered by this Codex; using its default voice`,
+            );
+        } catch (error) {
+            logger.error(
+                "Failed to list realtime voices; using the default voice",
+                error,
+            );
+        }
+        return undefined;
+    }
+
+    async start(
+        request: LodyVoiceStartRequest,
+    ): Promise<LodyVoiceStartResponse> {
+        const appServer = this.appServer();
+        // Dictation is never heard, so it keeps the default voice.
+        const voice =
+            request.mode === "dictation"
+                ? undefined
+                : await this.resolveVoice(request.voice);
+        // An empty private directory: the thread never runs tools, and nothing
+        // from a project should reach the voice's startup context.
+        const directory = mkdtempSync(path.join(os.tmpdir(), "lody-voice-"));
+        let threadId: string | null = null;
+        try {
+            const thread = await appServer.threadStart({
+                cwd: directory,
+                ephemeral: true,
+                approvalPolicy: "never",
+                sandbox: "read-only",
+            });
+            threadId = thread.thread.id;
+            const session: VoiceSession = {
+                id: randomUUID(),
+                mode: request.mode,
+                threadId,
+                appServer,
+                directory,
+                closed: false,
+            };
+            const answer = new Promise<string>((resolve, reject) => {
+                const timer = setTimeout(
+                    () =>
+                        reject(
+                            new Error(
+                                "Codex did not answer the voice call in time",
+                            ),
+                        ),
+                    SDP_ANSWER_TIMEOUT_MS,
+                );
+                appServer.onServerNotification(session.threadId, (event) => {
+                    if (event.method === "thread/realtime/sdp") {
+                        clearTimeout(timer);
+                        resolve(event.params.sdp);
+                        return;
+                    }
+                    if (
+                        event.method === "thread/realtime/error" &&
+                        !session.closed
+                    ) {
+                        clearTimeout(timer);
+                        reject(new Error(event.params.message));
+                    }
+                    void this.handleNotification(session, event);
+                });
+            });
+            this.sessions.set(session.id, session);
+            // Developer items, not appended context: appending after the start
+            // can make the voice speak up before the user has said anything.
+            const initialItems =
+                request.mode === "conversation"
+                    ? [request.instructions, request.context]
+                          .map((text) => text?.trim())
+                          .filter((text): text is string => Boolean(text))
+                          .map((text) => ({role: "developer", text}))
+                    : [];
+            await appServer.experimentalRequest("thread/realtime/start", {
+                threadId: session.threadId,
+                version: "v3",
+                // Text output needs realtime v2, which WebRTC calls do not support;
+                // dictation keeps audio output and the client simply never plays it.
+                outputModality: "audio",
+                includeStartupContext: false,
+                clientManagedHandoffs: true,
+                ...(request.mode === "dictation"
+                    ? {prompt: DICTATION_PROMPT}
+                    : {}),
+                ...(initialItems.length > 0 ? {initialItems} : {}),
+                ...(voice ? {voice} : {}),
+                transport: {type: "webrtc", sdp: request.sdp},
+            });
+            const sdp = await answer;
+            return {voiceSessionId: session.id, sdp};
+        } catch (error) {
+            for (const session of this.sessions.values()) {
+                if (session.threadId === threadId) {
+                    await this.close(session, null);
+                }
+            }
+            if (threadId === null) {
+                rmSync(directory, {recursive: true, force: true});
+            }
+            throw error;
+        }
+    }
+
+    async append(
+        request: LodyVoiceAppendRequest,
+    ): Promise<Record<string, never>> {
+        const session = this.requireSession(request.voiceSessionId);
+        await session.appServer.experimentalRequest(
+            "thread/realtime/appendText",
+            {
+                threadId: session.threadId,
+                role: "developer",
+                text: request.text,
+            },
+        );
+        return {};
+    }
+
+    async stop(request: LodyVoiceStopRequest): Promise<Record<string, never>> {
+        const session = this.sessions.get(request.voiceSessionId);
+        if (session) {
+            await this.close(session, "requested");
+        }
+        return {};
+    }
+
+    /** The app-server process is going away; its calls end with it. */
+    async closeAll(reason: string): Promise<void> {
+        for (const session of [...this.sessions.values()]) {
+            await this.close(session, reason, false);
+        }
+    }
+
+    private requireSession(voiceSessionId: string): VoiceSession {
+        const session = this.sessions.get(voiceSessionId);
+        if (!session) {
+            throw new Error(`Unknown voice session: ${voiceSessionId}`);
+        }
+        return session;
+    }
+
+    private async handleNotification(
+        session: VoiceSession,
+        event: ServerNotification,
+    ): Promise<void> {
+        if (session.closed) {
+            return;
+        }
+        switch (event.method) {
+            case "turn/started":
+                // The delegation already reached the client as a `request`.
+                await session.appServer
+                    .turnInterrupt({
+                        threadId: session.threadId,
+                        turnId: event.params.turn.id,
+                    })
+                    .catch((error) =>
+                        logger.error(
+                            "Failed to interrupt a voice delegation",
+                            error,
+                        ),
+                    );
+                return;
+            case "thread/realtime/itemAdded": {
+                const item = event.params.item as {
+                    type?: unknown;
+                    handoff_id?: unknown;
+                    input_transcript?: unknown;
+                } | null;
+                if (
+                    session.mode === "conversation" &&
+                    item?.type === "handoff_request" &&
+                    typeof item.input_transcript === "string" &&
+                    item.input_transcript.trim().length > 0
+                ) {
+                    await this.emit(session, {
+                        type: "request",
+                        requestId:
+                            typeof item.handoff_id === "string"
+                                ? item.handoff_id
+                                : randomUUID(),
+                        text: item.input_transcript.trim(),
+                    });
+                }
+                return;
+            }
+            case "thread/realtime/transcript/done": {
+                const role =
+                    event.params.role === "user" ? "user" : "assistant";
+                const text = event.params.text.trim();
+                if (
+                    text.length > 0 &&
+                    (session.mode === "conversation" || role === "user")
+                ) {
+                    await this.emit(session, {type: "transcript", role, text});
+                }
+                return;
+            }
+            case "thread/realtime/error":
+                await this.emit(session, {
+                    type: "error",
+                    message: event.params.message,
+                });
+                return;
+            case "thread/realtime/closed":
+                await this.close(session, event.params.reason ?? null, false);
+                return;
+            default:
+                return;
+        }
+    }
+
+    private async close(
+        session: VoiceSession,
+        reason: string | null,
+        stopCall = true,
+    ): Promise<void> {
+        if (session.closed) {
+            return;
+        }
+        session.closed = true;
+        this.sessions.delete(session.id);
+        if (stopCall) {
+            await session.appServer
+                .experimentalRequest("thread/realtime/stop", {
+                    threadId: session.threadId,
+                })
+                .catch((error) =>
+                    logger.error("Failed to stop a voice call", error),
+                );
+        }
+        session.appServer.offServerNotification(session.threadId);
+        rmSync(session.directory, {recursive: true, force: true});
+        await this.emit(session, {type: "closed", reason});
+    }
+
+    private async emit(
+        session: VoiceSession,
+        event: LodyVoiceEvent,
+    ): Promise<void> {
+        await this.notify({voiceSessionId: session.id, event}).catch((error) =>
+            logger.error("Failed to report a voice event", error),
+        );
+    }
+}
diff --git a/src/__tests__/VoiceExtension.test.ts b/src/__tests__/VoiceExtension.test.ts
new file mode 100644
index 0000000..a7882df
--- /dev/null
+++ b/src/__tests__/VoiceExtension.test.ts
@@ -0,0 +1,496 @@
+import {existsSync} from "node:fs";
+import * as acp from "@agentclientprotocol/sdk/unstable";
+import * as acpV2 from "@agentclientprotocol/sdk/experimental/v2/unstable";
+import {afterEach, describe, expect, it} from "vitest";
+import type {
+    LodyVoiceEventNotification,
+    LodyVoiceStartResponse,
+} from "acp-extension-core";
+import type {CodexAcpServer} from "../CodexAcpServer";
+import {createAcpAgentRouter} from "../AcpAgentRouter";
+import type {RealtimeVoicesList, ServerNotification} from "../app-server";
+import {CodexVoiceSessions, type VoiceAppServer} from "../VoiceExtension";
+
+/** An app-server that answers a call with `sdp` and records what it was asked. */
+class FakeAppServer implements VoiceAppServer {
+    readonly requests: {method: string; params: Record<string, unknown>}[] = [];
+    readonly interrupts: {threadId: string; turnId: string}[] = [];
+    readonly threadDirectories: string[] = [];
+    private readonly handlers = new Map<
+        string,
+        (event: ServerNotification) => void
+    >();
+    /** What `thread/realtime/listVoices` answers; an Error makes it fail. */
+    voiceList: RealtimeVoicesList | Error = {
+        v1: ["juniper", "maple", "cove"],
+        v2: ["alloy", "marin"],
+        defaultV1: "cove",
+        defaultV2: "marin",
+    };
+
+    constructor(
+        private readonly answer: (threadId: string) => ServerNotification,
+    ) {}
+
+    async threadStart(params: {cwd?: string | null}) {
+        this.threadDirectories.push(params.cwd ?? "");
+        return {
+            thread: {id: `thread-${this.threadDirectories.length}`},
+        } as never;
+    }
+
+    onServerNotification(
+        threadId: string,
+        callback: (event: ServerNotification) => void,
+    ) {
+        this.handlers.set(threadId, callback);
+    }
+
+    offServerNotification(threadId: string) {
+        this.handlers.delete(threadId);
+    }
+
+    async experimentalRequest(method: string, params: Record<string, unknown>) {
+        this.requests.push({method, params});
+        if (method === "thread/realtime/listVoices") {
+            if (this.voiceList instanceof Error) throw this.voiceList;
+            return {voices: this.voiceList};
+        }
+        if (method === "thread/realtime/start") {
+            const threadId = params["threadId"] as string;
+            queueMicrotask(() => this.emit(this.answer(threadId)));
+        }
+        return {};
+    }
+
+    async turnInterrupt(params: {threadId: string; turnId: string}) {
+        this.interrupts.push(params);
+        return {};
+    }
+
+    emit(event: ServerNotification) {
+        const threadId = (event.params as {threadId: string}).threadId;
+        this.handlers.get(threadId)?.(event);
+    }
+
+    isSubscribed(threadId: string) {
+        return this.handlers.has(threadId);
+    }
+}
+
+const sdpAnswer = (threadId: string) =>
+    ({
+        method: "thread/realtime/sdp",
+        params: {threadId, sdp: "answer-sdp"},
+    }) as ServerNotification;
+
+const activeSessions: CodexVoiceSessions[] = [];
+afterEach(async () => {
+    for (const sessions of activeSessions.splice(0)) await sessions.closeAll("test cleanup");
+});
+
+function createSessions(appServer: FakeAppServer) {
+    const events: LodyVoiceEventNotification[] = [];
+    const sessions = new CodexVoiceSessions(
+        () => appServer,
+        async (params) => {
+            events.push(params);
+        },
+    );
+    activeSessions.push(sessions);
+    return {sessions, events};
+}
+
+describe("CodexVoiceSessions", () => {
+    it.each([
+        {mode: "conversation", version: 1},
+        {mode: "dictation", version: 1},
+        {mode: "conversation", version: 2},
+        {mode: "dictation", version: 2},
+    ] as const)(
+        "routes all voice methods through production ACP v$version for $mode",
+        async ({mode, version}) => {
+            const appServer = new FakeAppServer(sdpAnswer);
+            const {sessions} = createSessions(appServer);
+            const app = createAcpAgentRouter(
+                () =>
+                    ({
+                        initialize: async () => ({
+                            protocolVersion: 1,
+                            agentCapabilities: {},
+                            authMethods: [],
+                        }),
+                        initializeV2: async () => ({
+                            protocolVersion: 2,
+                            info: {name: "voice-test", version: "1"},
+                            capabilities: {},
+                        }),
+                        voice: sessions,
+                        sessionIndex: {dispose() {}},
+                    }) as unknown as CodexAcpServer,
+            );
+
+            const clientToAgent = new TransformStream<Uint8Array, Uint8Array>();
+            const agentToClient = new TransformStream<Uint8Array, Uint8Array>();
+            app.connect(
+                acp.ndJsonStream(
+                    agentToClient.writable,
+                    clientToAgent.readable,
+                ),
+            );
+            const stream = acp.ndJsonStream(
+                clientToAgent.writable,
+                agentToClient.readable,
+            );
+            const client =
+                version === 1
+                    ? acp.client({name: "voice-client"}).connect(stream)
+                    : acpV2.client({name: "voice-client"}).connect(stream);
+            const connection: {
+                request(method: string, params: unknown): Promise<unknown>;
+            } = client.agent;
+            try {
+                await connection.request(
+                    "initialize",
+                    version === 1
+                        ? {protocolVersion: 1, clientCapabilities: {}}
+                        : {
+                              protocolVersion: 2,
+                              info: {name: "voice-client", version: "1"},
+                              capabilities: {},
+                          },
+                );
+                expect(
+                    await connection.request("_lody/voice/voices", {}),

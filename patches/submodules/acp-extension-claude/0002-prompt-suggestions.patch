@@ -14142,6 +14142,79 @@ describe("emitRawSDKMessages", () => {
     expect(sdkMessages.length).toBeGreaterThanOrEqual(3);
   });
 
+  it("forwards the prompt suggestion that arrives after the turn's result", async () => {
+    const extNotifications: { method: string; params: any }[] = [];
+    let suggestionDelivered!: () => void;
+    const delivered = new Promise<void>((resolve) => {
+      suggestionDelivered = resolve;
+    });
+    const agent = new ClaudeAcpAgent(
+      {
+        sessionUpdate: async () => {},
+        extNotification: async (method: string, params: any) => {
+          extNotifications.push({ method, params });
+          if (method === "_lody/session/prompt_suggestion") suggestionDelivered();
+        },
+      } as unknown as AcpClient,
+      { log: () => {}, error: () => {} },
+    );
+    let releaseSuggestion!: () => void;
+    const suggestionReady = new Promise<void>((resolve) => {
+      releaseSuggestion = resolve;
+    });
+    const input = new Pushable<any>();
+    async function* turnThenSuggestion() {
+      const { value: userMessage } = await input[Symbol.asyncIterator]().next();
+      yield {
+        type: "user",
+        message: userMessage.message,
+        parent_tool_use_id: null,
+        uuid: userMessage.uuid,
+        session_id: "test-session",
+        isReplay: true,
+      };
+      yield createResultMessage();
+      yield { type: "system", subtype: "session_state_changed", state: "idle" };
+      // The CLI forks the conversation for the guess once the turn is over.
+      await suggestionReady;
+      yield {
+        type: "prompt_suggestion",
+        suggestion: "  ",
+        uuid: randomUUID(),
+        session_id: "test-session",
+      };
+      yield {
+        type: "prompt_suggestion",
+        suggestion: "run the tests",
+        uuid: randomUUID(),
+        session_id: "test-session",
+      };
+    }
+    agent.sessions["test-session"] = mockSessionState({
+      query: wrapQuery(turnThenSuggestion()),
+      input,
+    });
+
+    const response = await agent.prompt({
+      sessionId: "test-session",
+      prompt: [{ type: "text", text: "fix the build" }],
+    });
+    expect(response.stopReason).toBe("end_turn");
+    expect(extNotifications.some((n) => n.method === "_lody/session/prompt_suggestion")).toBe(
+      false,
+    );
+
+    releaseSuggestion();
+    await delivered;
+
+    expect(extNotifications.filter((n) => n.method === "_lody/session/prompt_suggestion")).toEqual([
+      {
+        method: "_lody/session/prompt_suggestion",
+        params: { sessionId: "test-session", suggestion: "run the tests" },
+      },
+    ]);
+  });

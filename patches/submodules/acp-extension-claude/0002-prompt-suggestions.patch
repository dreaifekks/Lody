+/** Whether the client asked for a next-prompt guess after each turn
+ *  (`_meta.lody.promptSuggestions` on session start). Off unless asked: the
+ *  guess is an extra model call, cheap only while the prompt cache is warm. */
+export function lodyPromptSuggestionsRequested(meta: unknown): boolean {
+  if (!meta || typeof meta !== "object") return false;
+  const lody = (meta as Record<string, unknown>).lody;
+  if (!lody || typeof lody !== "object") return false;
+  const request = (lody as Record<string, unknown>).promptSuggestions;
+  return (
+    !!request && typeof request === "object" && (request as Record<string, unknown>).version === 1
+  );
+}
